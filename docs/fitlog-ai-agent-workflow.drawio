<mxfile host="app.diagrams.net" modified="2026-06-18T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="fitlog-ai-agent-workflow" name="FitLog AI Agent Workflow">
    <mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FitLog Diet Strategy Agent Workflow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="620" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="구현 위치: backend/app/services/fitlog.py - FitLogDietStrategyAgent&#10;역할: 목표, 식단 리포트, RAG 근거, 사용자 질문을 조합해 LLM 전략을 생성하고 DB에 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=13;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="850" y="25" width="680" height="72" as="geometry" />
        </mxCell>

        <mxCell id="frontend" value="사용자 / Coach UI&#10;오른쪽 하단 Coach 창&#10;date, question 입력" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="api" value="POST /api/fitlog/strategy&#10;payload: date, question&#10;get_current_user 인증" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="create" value="create_strategy()&#10;FitLogDietStrategyAgent 생성&#10;.run() 실행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="140" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="trace_start" value="agent_start 기록&#10;agent_steps에 실행 trace 추가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="940" y="140" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="goal" value="Tool 1&#10;get_active_goal()&#10;활성 목표 조회&#10;없으면 insufficient_data 응답" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="330" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="report" value="Tool 2&#10;build_daily_report()&#10;식단 기록 집계&#10;칼로리, 탄단지, 경고 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rag_query" value="RAG query 구성&#10;question + report.warnings + report.status&#10;현재 상태 기반 검색어 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rag" value="Tool 3&#10;search_knowledge()&#10;OpenAI embedding + pgvector 검색&#10;실패 시 keyword fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a21caf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1120" y="330" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="db" value="PostgreSQL&#10;goal_profiles&#10;meal_logs / meal_food_items&#10;nutrition_knowledge_docs vector(1536)&#10;strategy_advices" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="90" y="570" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="LLM prompt 구성&#10;goal + daily report + question + RAG evidence&#10;strict JSON 지시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="585" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="Tool 4&#10;generate_strategy_text()&#10;OpenAI Responses API 호출&#10;STRATEGY_AGENT_MODEL 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="585" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="응답 파싱 / 정규화&#10;normalize_strategy_payload()&#10;StrategyResponse 검증&#10;risk_notes list 보정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1160" y="585" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="save" value="Tool 5&#10;save_strategy()&#10;strategy_advices 저장&#10;rag_evidence_json + agent_trace_json 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="805" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="response" value="StrategyResponse 반환&#10;pace_status&#10;summary&#10;today_strategy / tomorrow_strategy&#10;risk_notes / rag_evidence / agent_steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="795" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ui_result" value="Coach UI 표시&#10;요약, 오늘 전략, 내일 전략&#10;Agent 실행 단계 목록 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1210" y="805" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Agent로 볼 수 있는 이유&#10;- 단순 LLM 호출이 아니라 여러 내부 tool을 순서대로 실행&#10;- 각 tool 실행 결과를 agent_steps로 기록&#10;- RAG 검색 결과와 사용자 상태를 조합해 전략 생성&#10;- 최종 결과를 DB에 저장해 이후 조회 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=14;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="1210" y="120" width="320" height="160" as="geometry" />
