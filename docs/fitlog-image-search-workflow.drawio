<mxfile host="app.diagrams.net" modified="2026-06-18T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="fitlog-image-search-workflow" name="FitLog Image Search Workflow">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FitLog Image Food Search Workflow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="650" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="구현 위치: frontend/src/components/ImageCropPicker.tsx, FitlogMealFormPage.tsx&#10;backend/app/api/fitlog_image_rag.py, services/fitlog_image_rag.py, services/fitlog_food_classifier.py&#10;현재 구현: 이미지 벡터 검색이 아니라 ResNet-34 분류 라벨 기반 음식 후보 검색 + 영양성분 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=13;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="760" y="25" width="860" height="88" as="geometry" />
        </mxCell>

        <mxCell id="user" value="사용자&#10;Add meal 화면&#10;음식 사진 업로드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cropper" value="ImageCropPicker&#10;canvas에서 영역 선택&#10;선택 영역이 있으면 crop Blob 생성&#10;없으면 원본 이미지 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="analyze" value="음식 분석 버튼&#10;FitlogMealFormPage.analyzeImage()&#10;targetImage = cropImage ?? image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="frontend_api" value="frontend api&#10;searchImageRag(image)&#10;FormData image=query.jpg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="980" y="150" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="post" value="POST /api/fitlog/image-rag/search&#10;UploadFile image&#10;로그인 사용자 필요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1290" y="150" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api" value="search_image_rag()&#10;image.read()로 bytes 추출&#10;classify_and_route_image(db, image_bytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="classifier_load" value="get_resnet34_food_classifier()&#10;torch.load(model_path)&#10;classes, model_state_dict 로드&#10;ResNet-34 fc를 class 수에 맞춤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a21caf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="preprocess" value="classify_food_image()&#10;PIL Image.open(bytes).convert('RGB')&#10;ImageNet transform 적용&#10;model.eval() forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5d0fe;strokeColor=#a21caf;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="800" y="350" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="topk" value="softmax + top-k&#10;FoodLabelCandidate[] 반환&#10;food_name, label, confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1170" y="360" width="260" height="115" as="geometry" />
        </mxCell>

        <mxCell id="route" value="route_classification_result()&#10;confidence 기준 분기&#10;auto_accept / user_confirm / manual_label_required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="590" y="585" width="310" height="125" as="geometry" />
        </mxCell>
        <mxCell id="thresholds" value="threshold 설정&#10;auto_accept_threshold = 0.8&#10;user_confirm_threshold = 0.5&#10;config.py / .env로 변경 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="950" y="585" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="nutrition" value="_nutrition_from_food_name()&#10;분류 라벨을 음식명으로 사용&#10;get_or_create_nutrition_estimate()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="585" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="nutrition_db" value="food_nutrition_estimates&#10;음식명 + 단위별 영양성분 캐시&#10;없으면 LLM 추정 후 저장" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="250" height="125" as="geometry" />
        </mxCell>

        <mxCell id="response" value="ImageRagSearchResponse&#10;query_handled&#10;mode / action&#10;accepted_food_name&#10;training_candidate_required&#10;top_k 후보 + 영양성분" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="805" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="프론트 후보 반영&#10;auto_accept면 첫 후보 자동 반영&#10;아니면 사용자가 후보 선택&#10;Foods에 음식명, 분량, 영양성분, 이미지 preview 추가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="805" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="save_meal" value="식단 저장 시&#10;POST /api/fitlog/meals&#10;meal image / crop image 저장&#10;food image_data_url은 food별 image_path로 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1380" y="805" width="260" height="145" as="geometry" />
        </mxCell>

        <mxCell id="future" value="추가 예정 영역&#10;food_image_training_candidates&#10;낮은 confidence 이미지 저장 후보&#10;food_image_embeddings vector 검색&#10;현재는 실제 migration/table 미구현" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=14;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="1260" y="570" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note" value="발표 포인트&#10;- 현재 이미지 검색기는 이미지 임베딩 RAG가 아님&#10;- 사진 → ResNet-34 분류 → 음식명 후보 → 영양성분 캐시/LLM 조회 구조&#10;- confidence가 높으면 자동 반영, 애매하면 사용자 확인, 낮으면 학습 후보로 설계" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=14;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="60" y="960" width="720" height="70" as="geometry" />
        </mxCell>

