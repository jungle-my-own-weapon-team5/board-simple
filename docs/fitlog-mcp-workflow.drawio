        </mxCell>
        <mxCell id="legend" value="구현 위치: backend/app/mcp/server.py, backend/app/mcp/tools.py&#10;역할: 외부 AI Agent가 FitLog 백엔드 service layer를 MCP tool로 호출하도록 연결" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=13;align=left;spacing=12" vertex="1" parent="1">
          <mxGeometry x="760" y="25" width="680" height="72" as="geometry" />
