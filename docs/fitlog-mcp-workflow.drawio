          <mxGeometry x="50" y="140" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="stdio" value="MCP stdio transport&#10;JSON-RPC 2.0&#10;Content-Length frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="server" value="Python MCP Server&#10;backend/app/mcp/server.py&#10;initialize / ping / tools/list / tools/call 처리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="140" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="MCP Tools&#10;get_daily_meals(date)&#10;get_daily_report(date)&#10;get_strategy_history(date?)&#10;create_strategy(date, question?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=14" vertex="1" parent="1">
