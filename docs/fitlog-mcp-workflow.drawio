        <mxCell id="env" value="환경변수&#10;FITLOG_MCP_USER_ID&#10;DATABASE_URL&#10;OPENAI_API_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="990" y="340" width="250" height="125" as="geometry" />
        </mxCell>

        <mxCell id="services" value="FitLog Service Layer&#10;build_daily_report()&#10;create_strategy()&#10;FitLogDietStrategyAgent&#10;search_knowledge()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="560" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL Database&#10;goal_profiles&#10;meal_logs / meal_food_items&#10;nutrition_knowledge_docs vector(1536)&#10;strategy_advices" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=14" vertex="1" parent="1">
