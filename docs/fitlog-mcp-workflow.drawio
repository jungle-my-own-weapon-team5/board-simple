        <mxCell id="response" value="MCP tool result&#10;service 결과를 JSON text content로 감싸 반환&#10;외부 Agent가 응답을 대화에 활용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=14;fontStyle=1" vertex="1" parent="1">
