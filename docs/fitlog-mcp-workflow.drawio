        <mxCell id="llm" value="외부 AI API&#10;OpenAI Embeddings&#10;OpenAI Responses API&#10;RAG / 전략 생성에 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#a21caf;fontSize=14" vertex="1" parent="1">
