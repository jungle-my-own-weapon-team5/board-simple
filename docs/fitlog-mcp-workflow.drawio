        </mxCell>
        <mxCell id="validation" value="입력 검증&#10;date: YYYY-MM-DD&#10;question: string optional&#10;FITLOG_MCP_USER_ID 필수" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="1310" y="140" width="190" height="105" as="geometry" />
        </mxCell>

        <mxCell id="tool_impl" value="Tool 구현&#10;backend/app/mcp/tools.py&#10;SQLAlchemy session 생성&#10;Pydantic schema로 JSON 직렬화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#65a30d;fontSize=14;fontStyle=1" vertex="1" parent="1">
