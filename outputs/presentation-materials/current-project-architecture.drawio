        <mxCell id="req" value="사용자 요청&lt;br&gt;제목 / 본문 / 글 유형 / 카테고리 / 메시지 / 최근 대화 8개" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B33A2E;fontSize=18;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
