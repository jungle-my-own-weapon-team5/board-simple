          <mxGeometry x="330" y="495" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="respond" value="respond 노드&lt;br&gt;LLM 또는 local fallback&lt;br&gt;agent_message 생성&lt;br&gt;suggested_content / title / tags / questions 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#18212F;fontSize=17;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
