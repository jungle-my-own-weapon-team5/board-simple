        <mxCell id="f4" style="endArrow=block;html=1;strokeWidth=2.5;strokeColor=#0E6F68;" edge="1" parent="1" source="retrieve" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="실행" style="endArrow=block;html=1;strokeWidth=2.5;strokeColor=#C7872A;fontSize=14;fontFamily=Malgun Gothic;" edge="1" parent="1" source="decision" target="external"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="생략" style="endArrow=block;html=1;strokeWidth=2.5;strokeColor=#8FA1B3;fontSize=14;fontFamily=Malgun Gothic;" edge="1" parent="1" source="decision" target="skip"><mxGeometry relative="1" as="geometry"/></mxCell>
