        </mxCell>
        <mxCell id="subtitle2" value="현재 코드의 LangGraph 노드는 intent, retrieve, external_search, respond 네 개입니다." style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontColor=#5B6472;fontFamily=Malgun Gothic;align=left;" vertex="1" parent="1">
          <mxGeometry x="62" y="96" width="1100" height="34" as="geometry"/>
