        <mxCell id="title2" value="Editor Agent 내부 워크플로우" style="text;html=1;strokeColor=none;fillColor=none;fontSize=36;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;align=left;" vertex="1" parent="1">
