        <mxCell id="safe" value="Safety 검사&lt;br&gt;1. 메시지 검사&lt;br&gt;2. 메시지+제목+본문 검사&lt;br&gt;차단 시 즉시 안전 응답" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE2DE;strokeColor=#B33A2E;fontSize=17;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="205" width="260" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="intent" value="intent 노드&lt;br&gt;요청 분류&lt;br&gt;answer / fill_content / revise_content&lt;br&gt;RAG query 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2EF;strokeColor=#0E6F68;fontSize=17;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="260" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="retrieve" value="retrieve 노드&lt;br&gt;search_rag(query, 3)&lt;br&gt;핵심어 기준 citation 필터링&lt;br&gt;weak_evidence 판단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2EF;strokeColor=#0E6F68;fontSize=17;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="170" width="280" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="decision" value="외부 검색 실행 조건&lt;br&gt;answer / fill_content 요청&lt;br&gt;또는 사료 조회 요청&lt;br&gt;또는 RAG 근거 약함" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#C7872A;fontSize=16;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;" vertex="1" parent="1">
