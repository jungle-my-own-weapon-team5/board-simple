        </mxCell>

        <mxCell id="rag_side" value="RAG 데이터&lt;br&gt;backend/rag_seed/**/*.md&lt;br&gt;rag_documents / rag_chunks&lt;br&gt;metadata_json, corpus, source_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#516B86;fontSize=16;fontColor=#18212F;fontFamily=Malgun Gothic;arcSize=10;" vertex="1" parent="1">
