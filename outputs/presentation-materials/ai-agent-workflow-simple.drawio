        <mxCell id="t1" value="에디터 옆 AI Agent는 무엇을 하나?" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#18212F;fontFamily=Malgun Gothic;align=left;" vertex="1" parent="1">
